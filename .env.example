// Local environment configuration for QuranBest Akademi Admin Dashboard
// Copy to .env.local and fill with your actual tokens or credentials.
// Do NOT commit .env.local to git repository.

VITE_API_BASE_URL=https://plus-api.quranbest.com/v1
# Optional: Initial access token & refresh token from manual CMS login
VITE_ACCESS_TOKEN=
VITE_REFRESH_TOKEN=

# Supabase Database (Pencatatan Tracking Pengingat)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

